# Fantasy OS — variables de entorno (copia a .env.local en local; en Netlify, en Site configuration → Environment variables)

# ── Supabase (producción / Netlify) ──
# Si las tres están definidas se usa Supabase (Postgres + login). Si falta alguna, la app funciona
# en modo local con SQLite y sin login.
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Clave secreta: SOLO servidor. Nunca la pongas en una variable NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=sb_secret_...

# Secreto para /api/cron/daily (lo usan las funciones programadas de Netlify). Cadena larga aleatoria.
FOS_CRON_SECRET=

# ── Opcionales ──
# Quién puede entrar (ids de Supabase Auth separados por comas, o * para todos).
# Sin valor: solo la cuenta del propietario (ver src/lib/supabase/access.ts).
FOS_ALLOWED_USER_IDS=
# Enlace a Quiniela OS
NEXT_PUBLIC_QUINIELA_URL=https://quinielaos.netlify.app
# Carpeta de las bases de datos SQLite en modo local. Por defecto ./data
FOS_DATA_DIR=./data
# "false" desactiva la lectura de FútbolFantasy (solo datos manuales / CSV).
FOS_ENABLE_FUTBOLFANTASY=true
# Minutos mínimos entre dos sincronizaciones de la misma fuente.
FOS_MIN_SYNC_INTERVAL_MIN=60
# Clave gratuita de https://www.football-data.org para el calendario (si no, openfootball).
FOOTBALL_DATA_API_KEY=

# Notificaciones push (Web Push). Genera las claves con: npx web-push generate-vapid-keys
# La pública puede ir al navegador; la privada es SECRETA (solo en el servidor / Netlify).
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contacto para los servicios de push (una URL o mailto:)
VAPID_SUBJECT=https://fantasyos.netlify.app
