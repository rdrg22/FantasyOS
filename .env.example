# Fantasy OS — variables de entorno (solo servidor; nunca se exponen al navegador)

# Carpeta donde se guardan las bases de datos SQLite (real y demo). Por defecto ./data
FOS_DATA_DIR=./data

# Activa la importación desde las páginas públicas de FútbolFantasy (mercado, puntos, alineaciones).
# Ponlo a "false" para trabajar solo con datos manuales / CSV.
FOS_ENABLE_FUTBOLFANTASY=true

# Intervalo mínimo (minutos) entre dos sincronizaciones de la misma fuente. Evita peticiones repetidas.
FOS_MIN_SYNC_INTERVAL_MIN=60

# Opcional: clave gratuita de https://www.football-data.org (cabecera X-Auth-Token).
# Si no se define, el calendario se obtiene de openfootball (dominio público, sin clave).
FOOTBALL_DATA_API_KEY=

# Opcional: secreto para proteger /api/cron/daily si lo llamas desde un programador externo.
FOS_CRON_SECRET=
